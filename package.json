{
  "name": "olympus-workspace",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "format": "pnpm format:prettier && pnpm format:toml",
    "format:check": "pnpm format:prettier:check && pnpm format:toml:check",
    "format:prettier": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,css,yml,yaml}\"",
    "format:prettier:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,css,yml,yaml}\"",
    "format:toml": "taplo format",
    "format:toml:check": "taplo format --check",
    "license:headers": "node scripts/check-license-headers.mjs",
    "license:headers:update-baseline": "node scripts/check-license-headers.mjs --update-baseline",
    "license:headers:test": "node --test scripts/check-license-headers.test.mjs",
    "release-actions:check": "node scripts/check-privileged-action-pins.mjs",
    "release-actions:test": "node --test scripts/check-privileged-action-pins.test.mjs",
    "release-assets:test": "node --test scripts/release-assets.test.mjs",
    "tooling:check": "pnpm format:check && pnpm license:headers && pnpm license:headers:test && pnpm release-actions:check && pnpm release-actions:test && pnpm release-assets:test"
  },
  "devDependencies": {
    "@taplo/cli": "^0.7.0",
    "prettier": "^3.9.5",
    "eslint": "^9.39.5",
    "js-yaml": "^5.2.2"
  }
}
