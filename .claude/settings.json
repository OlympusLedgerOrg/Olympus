{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["wiserepo", "serena"],
  "permissions": {
    "deny": [
      "Read(./graphify-out/**)",
      "Read(./target/**)",
      "Read(./node_modules/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/verify-gate.sh\"",
            "timeout": 300,
            "statusMessage": "verify-gate --fast (change-scoped) before commit..."
          }
        ]
      }
    ]
  }
}
