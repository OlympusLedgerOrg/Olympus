#!/usr/bin/env bash
# pre-commit hook — hybrid Rust + frontend lint/format on staged files.
# Activate by running:  bash scripts/install-hooks.sh
#
# Behavior:
#   - Detects which staged files matter (Rust vs frontend vs neither).
#   - Auto-formats staged Rust files (cargo fmt) and runs cargo clippy.
#   - Auto-fixes staged frontend files (eslint --fix) and runs tsc -b
#     (composite mode, matches `pnpm build` in CI — `tsc --noEmit` is
#     looser and misses type narrowing that CI catches).
#   - Re-stages files the formatter touched (intentional per dev preference).
#   - If CLAUDE.md is staged, regenerates AGENTS.md from it via wiserepo
#     (tools/wiserepo) and re-stages the result — see that block below.
#   - If only docs / config files are staged, exits quickly with no other checks.
#
# Bypass with: OLYMPUS_SKIP_PRECOMMIT=1 git commit ...
# Or:          git commit --no-verify ...
# wiserepo's AGENTS.md sync alone can be skipped with: WISEREPO_SKIP=1

set -euo pipefail

if [ "${OLYMPUS_SKIP_PRECOMMIT:-0}" = "1" ]; then
    echo "[pre-commit] OLYMPUS_SKIP_PRECOMMIT=1 — skipping."
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Colors (POSIX-portable)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
RESET='\033[0m'

pass() { echo -e "  ${GREEN}✓${RESET} $1"; }
fail() { echo -e "  ${RED}✗${RESET} $1"; }
step() { echo -e "\n${BOLD}▸ $1${RESET}"; }

# Collect files to validate.
#
# Normal commits validate staged files (Added / Copied / Modified / Renamed —
# skip Deleted). Merge commits are different: the index contains every path
# brought in from the other parent, so a conflict-only frontend merge can look
# like a huge Rust commit and trigger workspace clippy. With the ort merge
# strategy, AUTO_MERGE records the conflicted tree before manual resolution; the
# diff from AUTO_MERGE to the index is the set of files actually resolved by the
# developer.
if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ] \
    && git rev-parse --verify AUTO_MERGE >/dev/null 2>&1; then
    STAGED_ALL="$(git diff --cached --name-only --diff-filter=ACMR AUTO_MERGE -- || true)"
else
    STAGED_ALL="$(git diff --cached --name-only --diff-filter=ACMR || true)"
fi

if [ -z "$STAGED_ALL" ]; then
    exit 0
fi

FAILED=()
# Parallel counter. `${#FAILED[@]}` on an EMPTY array is an "unbound variable"
# error under `set -u` in bash < 4.4 — which includes the bash 3.2 that ships
# with macOS, a platform this repo targets. Tracking the count separately
# keeps every check below portable.
FAILED_COUNT=0

record_failure() {
    fail "$1"
    FAILED+=("$1")
    FAILED_COUNT=$((FAILED_COUNT + 1))
}

print_failures() {
    echo ""
    echo "────────────────────────────────────"
    echo -e "${RED}${BOLD}Pre-commit gate failed:${RESET}"
    for f in ${FAILED[@]+"${FAILED[@]}"}; do
        echo -e "  ${RED}✗${RESET} $f"
    done
}

echo -e "${BOLD}Olympus pre-commit hook${RESET}"
echo "────────────────────────────────────"

# ── wiserepo: keep AGENTS.md synced with CLAUDE.md ─────────────────────────
# CLAUDE.md is the source of truth; AGENTS.md is the Codex-framed copy of it
# and drifts the moment someone edits one but not the other (this happened
# for real — see commit 4f5e270f). Regenerate AGENTS.md via wiserepo whenever
# CLAUDE.md is staged, and re-stage the result so it commits atomically with
# the CLAUDE.md change.
STAGED_CLAUDE_MD="$(echo "$STAGED_ALL" | grep -E '^CLAUDE\.md$' || true)"
if [ -n "$STAGED_CLAUDE_MD" ] && [ "${WISEREPO_SKIP:-0}" != "1" ]; then
    step "wiserepo: sync AGENTS.md from CLAUDE.md"
    if [ ! -d "$ROOT/tools/wiserepo/node_modules" ]; then
        echo "  (skipped — run 'npm install' in tools/wiserepo first)"
    elif [ -z "${ANTHROPIC_API_KEY:-}${OPENAI_API_KEY:-}" ]; then
        echo "  (skipped — set ANTHROPIC_API_KEY or OPENAI_API_KEY to enable; or set WISEREPO_SKIP=1 to silence this)"
    else
        rc=0
        node tools/wiserepo/bin/sync-agent-docs.mjs || rc=$?
        if [ "$rc" -eq 0 ]; then
            git add AGENTS.md
            pass "AGENTS.md synced"
        elif [ "$rc" -eq 2 ]; then
            # Model unavailable (no key / network / timeout) — the check
            # didn't run, it didn't fail. Non-blocking.
            echo "  (skipped — wiserepo backend unavailable, see output above)"
        else
            # Structural-parity check failed, or wiserepo itself is broken.
            # Either way the model's output cannot be trusted into a
            # security-relevant doc — block the commit deliberately.
            record_failure "wiserepo AGENTS.md sync"
        fi
    fi
fi

# Partition into Rust and frontend buckets.
# Rust: *.rs anywhere, plus Cargo.toml / Cargo.lock at any depth.
STAGED_RS="$(echo "$STAGED_ALL" | grep -E '(^|/)Cargo\.(toml|lock)$|\.rs$' || true)"
# Frontend: anything under app/public-ui/ that's a JS/TS source or styles.
# Also pnpm-lock.yaml at root.
STAGED_FE="$(echo "$STAGED_ALL" | grep -E '^app/public-ui/.*\.(ts|tsx|js|jsx|css|html)$|^pnpm-lock\.yaml$|^app/public-ui/package\.json$' || true)"

if [ -z "$STAGED_RS" ] && [ -z "$STAGED_FE" ]; then
    if [ "$FAILED_COUNT" -gt 0 ]; then
        print_failures
        exit 1
    fi
    # Docs / config / migrations / etc. and nothing else to do.
    echo ""
    echo -e "${GREEN}${BOLD}All checks passed.${RESET}\n"
    exit 0
fi

# Run a formatter over the working tree and stage ONLY what was already staged.
#
# `git add <file>` stages the whole working-tree file. For a file carrying both
# staged and unstaged hunks that sweeps the unstaged work into the commit — and
# because the formatter has rewritten the file in place, the developer cannot
# easily see what moved. So: snapshot the unstaged hunks, reset those files to
# their staged content, format, stage the formatted result, then restore the
# hunks on top.
#
# Files with no unstaged changes take the same path as before; for them
# working tree and index already agree, so the snapshot is a no-op.
#
# Restoration copies the saved bytes back rather than re-applying a diff. A
# diff cannot be relied on here: its context is the PRE-format file, so it
# stops applying in exactly the case that matters — when the formatter
# actually changed something. A byte-exact copy always succeeds, and leaves
# the developer's in-progress file precisely as they left it.
#
# Staging and preservation are deliberately two different sets. Only the
# originally staged files are re-staged, but EVERY unstaged modification the
# formatter could overwrite is preserved — `cargo fmt --all` rewrites the whole
# crate, not just the files we handed it, so a pg-embed-local file with
# unstaged-only edits would otherwise be reformatted in place, silently
# rewriting work the developer never staged.
#
# $1 — newline-separated files to re-stage
# $2 — name of a function that formats the working tree
# $3 — optional pathspec covering everything the formatter may write. Defaults
#      to the staged files (true for per-file rustfmt, false for cargo fmt).
format_staged_only() {
    local files="$1" formatter="$2" scope="${3:-}"
    local mixed="" preserve="" backup="" rc=0 f

    # Files with BOTH staged and unstaged changes (index vs working tree).
    mixed="$(echo "$files" | xargs -r git diff --name-only -- || true)"

    if [ -n "$scope" ]; then
        # Every unstaged modification inside the formatter's write scope,
        # including files that are not staged at all.
        preserve="$(printf '%s\n%s\n' "$mixed" "$(git diff --name-only -- "$scope" || true)" |
            grep -v '^$' | sort -u || true)"
    else
        preserve="$mixed"
    fi

    if [ -n "$preserve" ]; then
        backup="$(mktemp -d)"
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            mkdir -p "$backup/$(dirname "$f")"
            if [ -e "$f" ]; then
                cp -p "$f" "$backup/$f"
            else
                # An unstaged DELETION. There are no bytes to copy, and a bare
                # `cp` here would fail the hook under `set -e`. Record the
                # deletion so the restore re-applies it rather than resurrecting
                # a file the developer removed.
                : >"$backup/$f.olympus-deleted"
            fi
        done <<<"$preserve"
    fi

    if [ -n "$mixed" ]; then
        # Working tree := staged content, so the formatter sees exactly what is
        # about to be committed and nothing else. Only the files we will stage
        # need this; the rest are merely protected from being rewritten.
        echo "$mixed" | xargs -r git checkout --
    fi

    "$formatter" || rc=1

    if [ "$rc" -eq 0 ]; then
        echo "$files" | xargs -r git add --
    fi

    if [ -n "$preserve" ]; then
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            if [ -e "$backup/$f.olympus-deleted" ]; then
                rm -f "$f"
            else
                cp -p "$backup/$f" "$f"
            fi
        done <<<"$preserve"
        rm -rf "$backup"
    fi

    return "$rc"
}

# ── Rust ────────────────────────────────────────────────────────────────────
if [ -n "$STAGED_RS" ]; then
    # Format ONLY the staged .rs files — NOT `cargo fmt --all`, which rewrites the
    # whole workspace and churns unrelated files whenever the local rustfmt version
    # differs from the one main was last formatted with. There is no CI fmt gate to
    # anchor to and the repo has no workspace rustfmt.toml (rustfmt defaults), so a
    # workspace-wide reformat is both unenforced and version-fragile. Stable rustfmt
    # + --edition 2021 matches that default for the first-party crates.
    #
    # `pg-embed-local` is excluded because that assumption is false for it, and
    # silently so. It is edition 2024 with its own rustfmt.toml, and it *does*
    # have a CI fmt gate (`cargo fmt --manifest-path pg-embed-local/Cargo.toml
    # --all --check`). Running bare `rustfmt --edition 2021` over one of its
    # files reorders `use` groups to the 2021 style, re-stages the result, and
    # lands unrelated import churn that the 2024 gate then rejects — which is
    # exactly how a green local commit produced a red `rustfmt + clippy` job.
    # Defer to the same `cargo fmt` invocation CI runs, which reads the crate's
    # edition and config.
    STAGED_RS_SRC="$(echo "$STAGED_RS" | grep -E '\.rs$' | grep -v '^pg-embed-local/' || true)"
    STAGED_RS_PG_EMBED="$(echo "$STAGED_RS" | grep -E '^pg-embed-local/.*\.rs$' || true)"
    run_rustfmt_src() { echo "$STAGED_RS_SRC" | xargs -r rustfmt --edition 2021; }
    run_cargo_fmt_pg_embed() { cargo fmt --manifest-path pg-embed-local/Cargo.toml --all; }

    if [ -n "$STAGED_RS_SRC" ]; then
        step "rustfmt (staged Rust files)"
        if format_staged_only "$STAGED_RS_SRC" run_rustfmt_src; then
            pass "rustfmt"
        else
            record_failure "rustfmt"
        fi
    fi

    if [ -n "$STAGED_RS_PG_EMBED" ]; then
        step "cargo fmt (pg-embed-local, edition 2024 + own rustfmt.toml)"
        # `cargo fmt --all` rewrites the whole crate, so this MUST go through
        # format_staged_only — otherwise a file with unstaged hunks has them
        # both reformatted and committed. The third argument is that write
        # scope: unstaged-only files in the crate are protected too, even
        # though they are never staged.
        if format_staged_only "$STAGED_RS_PG_EMBED" run_cargo_fmt_pg_embed pg-embed-local; then
            pass "cargo fmt (pg-embed-local)"
        else
            record_failure "cargo fmt (pg-embed-local)"
        fi
    fi

    step "cargo clippy --workspace --all-targets -- -D warnings"
    if cargo clippy --workspace --all-targets --quiet -- -D warnings; then
        pass "cargo clippy"
    else
        record_failure "cargo clippy"
    fi
fi

# ── Frontend ────────────────────────────────────────────────────────────────
if [ -n "$STAGED_FE" ]; then
    # Filter to files inside app/public-ui (for eslint scoping).
    STAGED_FE_RELATIVE="$(echo "$STAGED_FE" | grep '^app/public-ui/' | sed 's|^app/public-ui/||' || true)"

    if [ -n "$STAGED_FE_RELATIVE" ]; then
        step "eslint --fix (auto-fix staged frontend)"
        if (cd app/public-ui && echo "$STAGED_FE_RELATIVE" | xargs -r pnpm exec eslint --fix --no-warn-ignored); then
            # Re-stage in case eslint --fix changed anything.
            echo "$STAGED_FE" | grep '^app/public-ui/' | xargs -r git add --
            pass "eslint"
        else
            record_failure "eslint"
        fi
    fi

    # Use `tsc -b` (project-references / composite mode) rather than
    # `tsc --noEmit`. The two have meaningfully different strictness:
    # `--noEmit` skips a few project-references checks and lets some
    # narrowing-derived errors slip through, while `tsc -b` matches what
    # CI's `pnpm build` (= `tsc -b && vite build`) runs. The 2026-05-28
    # `(0|1)[]` slip in redactionBinding.conformance.test.ts is the case
    # this comment exists to prevent recurring.
    step "tsc -b (frontend type-check, composite mode)"
    if (cd app/public-ui && pnpm exec tsc -b); then
        pass "tsc"
    else
        record_failure "tsc"
    fi
fi

echo ""
echo "────────────────────────────────────"

if [ "$FAILED_COUNT" -gt 0 ]; then
    echo -e "${RED}${BOLD}Pre-commit gate failed:${RESET}"
    for f in ${FAILED[@]+"${FAILED[@]}"}; do
        echo -e "  ${RED}✗${RESET} $f"
    done
    echo ""
    echo -e "${YELLOW}Fix the above, or bypass with:${RESET}"
    echo -e "  OLYMPUS_SKIP_PRECOMMIT=1 git commit ..."
    echo -e "  # or  git commit --no-verify ..."
    echo ""
    exit 1
fi

echo -e "${GREEN}${BOLD}All checks passed.${RESET}\n"
exit 0
