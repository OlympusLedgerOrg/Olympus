{
  "version": 1,
  "comment": "Default-deny. A repo-relative path may reach the local model only when it matches `allow` AND does not match `deny`; anything unmatched is refused. Enforced on normalized paths (diff headers, request file lists, grep hits, path-like tokens in the task text), never on prose alone. Consumed by tools/agent-policy/policy.mjs, tools/model-router/route.mjs and tools/wiserepo/src/policy.mjs.",
  "defaultDecision": "deny",
  "deny": [
    "crates/**",
    "src-tauri/**",
    "proofs/**",
    "verifiers/**",
    "migrations/**",
    "migrations-sqlite/**",
    "clients/**",
    ".github/**",
    "tools/**",
    "scripts/**",
    ".claude/**",
    ".mcp.json",
    ".githooks/**",
    ".cargo/**",
    ".config/**",
    ".devcontainer/**",
    ".semgrep/**",
    ".vscode/**",
    "graphify-out/**",
    "node_modules/**",
    "target/**",
    "vendor/**",
    "secrets/**",
    "**/Cargo.toml",
    "**/Cargo.lock",
    "**/package.json",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/pnpm-workspace.yaml",
    "**/taplo.toml",
    "**/Dockerfile",
    "**/Dockerfile.*",
    "docker/**",
    "**/*.zkey",
    "**/*.ptau",
    "**/*.r1cs",
    "**/*.wasm",
    "**/*.wtns",
    "**/*.pem",
    "**/*.key",
    "**/*.sig",
    "**/*.signature",
    "**/CODEOWNERS",
    "**/.env*",
    ".env*",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/SECURITY_AUDIT_*",
    "docs/audits/**",
    "docs/adr/**",
    "app/**/*verify*",
    "app/**/*sign*",
    "app/**/*key*",
    "app/**/*proof*",
    "app/**/*bundle*"
  ],
  "allow": [
    "app/public-ui/src/**",
    "app/public-ui/*.html",
    "docs/**",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "NOTICE",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "taskClasses": {
    "qa": { "paths": "allow" },
    "review": { "paths": "allow" },
    "summarize": { "paths": "allow" },
    "log-summary": { "paths": "allow" },
    "pr-text": { "paths": "allow" },
    "docstring": { "paths": ["app/public-ui/src/**"] },
    "test-scaffold": { "paths": ["app/public-ui/src/**"] }
  },
  "escalateKeywords": [
    "crypto",
    "cryptography",
    "cryptographic",
    "hash",
    "hashes",
    "hashing",
    "signature",
    "signatures",
    "signing",
    "secret",
    "secrets",
    "auth",
    "authentication",
    "authorization",
    "permission",
    "permissions",
    "scope",
    "scopes",
    "proof",
    "proofs",
    "zk",
    "snark",
    "snarks",
    "smt",
    "migration",
    "migrations",
    "security",
    "vulnerability",
    "vulnerabilities",
    "ledger",
    "redaction",
    "quorum",
    "anchor",
    "anchors",
    "anchoring",
    "merkle",
    "poseidon",
    "blake3",
    "ed25519",
    "pedersen",
    "federation",
    "attestation"
  ],
  "criticalKeywords": [
    "crypto",
    "cryptography",
    "cryptographic",
    "hash",
    "signature",
    "signatures",
    "signing",
    "key material",
    "auth",
    "authentication",
    "authorization",
    "proof",
    "proofs",
    "zk",
    "snark",
    "smt",
    "migration",
    "migrations",
    "ledger",
    "redaction",
    "quorum",
    "merkle",
    "poseidon",
    "blake3",
    "ed25519",
    "attestation"
  ],
  "criticalPrefixes": [
    "crates/",
    "src-tauri/",
    "proofs/",
    "verifiers/",
    "clients/",
    "migrations/",
    "migrations-sqlite/"
  ],
  "models": {
    "local": {
      "local": "qwen2.5-coder:7b-instruct"
    },
    "claude-code": {
      "local": "qwen2.5-coder:7b-instruct",
      "mid": "claude-sonnet-4-5",
      "top": "claude-opus-4-5"
    },
    "codex": {
      "local": "qwen2.5-coder:7b-instruct",
      "mid": "gpt-5-codex",
      "top": "gpt-5-codex-max"
    },
    "cli": {
      "local": "qwen2.5-coder:7b-instruct",
      "mid": "mid-tier",
      "top": "top-tier"
    }
  }
}
