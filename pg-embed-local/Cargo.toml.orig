# NOT A BUILD INPUT. Cargo reads `Cargo.toml`; this is the pre-normalization copy
# left behind when the crate was vendored from its published `.crate` package.
# It is kept only as provenance for what upstream shipped. Any edit here has no
# effect on the build, so change `Cargo.toml` and mirror it here — never the
# reverse. It is mirrored rather than deleted so the two cannot silently disagree
# about things like the MSRV, which is exactly what happened after #1509.
[package]
name = "pg-embed"
version = "1.0.0"
license = "MIT/Apache-2.0"
readme = "README.md"
repository = "https://github.com/faokunega/pg-embed"
documentation = "https://docs.rs/pg-embed"
description = "Run a Postgresql database locally on Linux, MacOS or Windows as part of another Rust application or test."
edition = "2024"
# Mirrors Cargo.toml: the lease code calls File::try_lock/try_lock_shared,
# stabilised in 1.89, so 1.88 could never build this crate. 1.94 matches
# src-tauri, its only consumer.
rust-version = "1.94"
keywords = ["database", "postgres", "postgresql", "embedded", "server"]
categories = [
    "database",
    "database-implementations",
    "development-tools",
    "asynchronous",
]
authors = ["Franz-Aliu Okunega <aokunega@gmail.com>"]

[features]
default = ["rt_tokio_migrate"]
# Mirrors Cargo.toml. Upstream noted "for now only rt_tokio or rt_tokio_migrate
# can be used", but nothing enforced it and this fork enables both at once, so
# migrate is declared as the superset it always was in practice.
rt_tokio = ["tokio", "reqwest"]
rt_tokio_migrate = ["rt_tokio", "sqlx"]

[dependencies]
reqwest = { version = "0.13", optional = true }
tokio = { version = "1", features = ["full"], optional = true }
thiserror = "2"
zip = "8"
lzma-rs = "0.3"
tar = "0.4"
sqlx = { version = "0.9", features = ["runtime-tokio", "tls-rustls", "postgres", "migrate"], optional = true }
log = "0.4"
dirs = "6.0"
hex = "0.4"
sha2 = "0.10"

[dev-dependencies]
futures = "0.3"
serial_test = { version = "3", features = ["file_locks"] }
env_logger = "0.11"
tempfile = "3"

[[test]]
name = "lifecycle"
path = "tests/lifecycle.rs"
required-features = ["rt_tokio"]

[[test]]
name = "auth"
path = "tests/auth.rs"
required-features = ["rt_tokio"]

[[test]]
name = "database"
path = "tests/database.rs"
required-features = ["rt_tokio_migrate"]

[[test]]
name = "migration"
path = "tests/migration.rs"
required-features = ["rt_tokio_migrate"]

[[test]]
name = "extension"
path = "tests/extension.rs"
required-features = ["rt_tokio_migrate"]
