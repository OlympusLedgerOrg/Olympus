# Generated by Cargo
# will have compiled files and executables
/target/

# Cargo.lock IS tracked here, deliberately — upstream's "leave it out for
# libraries" advice assumes a crate published to a registry, which this fork is
# not. It is vendored, workspace-excluded, and its library unit tests are gated
# by the `vendored pg_embed unit tests` CI job, which runs `--locked` so the
# suite is reproducible and the lockfile is covered by the supply-chain audit.
# Regenerate with:
#   cargo generate-lockfile --manifest-path pg-embed-local/Cargo.toml

# These are backup files generated by rustfmt
**/*.rs.bk

/data_test/
/data/
.idea
